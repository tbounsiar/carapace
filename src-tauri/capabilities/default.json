{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-get-config",
    "allow-create-project",
    "allow-rename-project",
    "allow-delete-project",
    "allow-create-environment",
    "allow-rename-environment",
    "allow-delete-environment",
    "allow-set-active-environment",
    "allow-set-variables",
    "allow-create-host",
    "allow-update-host",
    "allow-delete-host",
    "allow-resolve-host",
    "allow-connect-host",
    "allow-answer-host-key",
    "allow-replace-host-key",
    "allow-disconnect-host",
    "allow-list-connections",
    "allow-open-terminal",
    "allow-write-terminal",
    "allow-resize-terminal",
    "allow-close-terminal",
    "allow-forget-saved-secrets",
    "allow-sftp-list",
    "allow-sftp-mkdir",
    "allow-sftp-rename",
    "allow-sftp-delete",
    "allow-local-home",
    "allow-local-list",
    "allow-local-mkdir",
    "allow-local-rename",
    "allow-local-delete",
    "allow-subscribe-transfers",
    "allow-enqueue-transfers",
    "allow-cancel-transfer",
    "allow-answer-conflict",
    "allow-clear-finished-transfers",
    "allow-keys-dir",
    "allow-list-keys",
    "allow-generate-key",
    "allow-import-key",
    "allow-rename-key",
    "allow-delete-key",
    "allow-forget-key-passphrase",
    "allow-deploy-public-key"
  ]
}

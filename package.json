{
  "name": "carapace",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "tauri": "tauri",
    "lint": "ng lint",
    "e2e:build": "tauri build --debug --no-bundle --features e2e-pickers,e2e-offscreen --config src-tauri/tauri.e2e.conf.json",
    "e2e:ui": "wdio run e2e/wdio/wdio.conf.ts",
    "e2e:driver": "pwsh -NoProfile -File e2e/wdio/fetch-driver.ps1"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@taiga-ui/addon-mobile": "^5.30.0",
    "@taiga-ui/addon-table": "^5.30.0",
    "@taiga-ui/cdk": "^5.30.0",
    "@taiga-ui/core": "^5.30.0",
    "@taiga-ui/icons": "^5.30.0",
    "@taiga-ui/kit": "^5.30.0",
    "@taiga-ui/layout": "^5.30.0",
    "@tauri-apps/api": "^2.12.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "@wdio/cli": "^10.1.0",
    "@wdio/globals": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/mocha-framework": "^10.1.0",
    "@wdio/spec-reporter": "^10.1.0",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "less": "^4.9.1",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  },
  "license": "MIT",
  "description": "Desktop SSH and SFTP client: dual-pane file explorer and terminal tabs",
  "author": "Tahar BOUNSIAR",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tbounsiar/carapace.git"
  },
  "homepage": "https://github.com/tbounsiar/carapace",
  "bugs": {
    "url": "https://github.com/tbounsiar/carapace/issues"
  }
}
